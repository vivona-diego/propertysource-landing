# Public GA4 identifier. Local development and private data-room routes are not tracked.
VITE_GA_MEASUREMENT_ID=G-9661Q40LRG
# For Preview deployments, VITE_GA_MEASUREMENT_ID=disabled

# Backend-only secrets: configure privately in your hosting dashboard.
# Copy the EXISTING approved values when migrating the current room.
# Never place these values in a VITE_ variable or commit a populated .env file.
DATABASE_URL=
JWT_SECRET=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional separate encryption key. For existing documents, preserve the key
# actually used to encrypt them; if this was unset, preserve JWT_SECRET exactly.
# DATA_ROOM_ENCRYPTION_KEY=

# Optional verified-owner OAuth setup. Individual data-room password logins
# work independently once the database and existing administrator are configured.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
